# Copy to .env and fill in values

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fishingapp
DB_PASSWORD=fishingapp
DB_NAME=fishingapp

# --- HTTP ---
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173

# --- Required: NWS API ---
# Must be a string identifying your app (per NWS API rules)
NWS_USER_AGENT=(puget-sound-fishing-app, you@example.com)

# --- Optional: USNO polite identifier (<= 8 chars) ---
USNO_APP_ID=psfish

# --- Optional: WeatherAPI.com (free tier, marine endpoint) ---
# Sign up at https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=

# --- Optional: OpenWeatherMap ---
# Sign up at https://openweathermap.org/api
OWM_API_KEY=

# --- Optional/Deferred: AISStream.io ---
# Sign up at https://www.aisstream.io/apikeys
AISSTREAM_API_KEY=
